FROM python:3.10-slim

WORKDIR /app

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY kafka_connectors.py stream_processor.py ./

USER appuser

CMD sh -c "echo 'Waiting 15s for Kafka to be ready...' && sleep 15 && echo 'Starting Bytewax processor...' && python -m bytewax.run stream_processor:flow -w 2"